#!/bin/sh
# Stops a commit whose staged files fail the same Prettier check CI runs (npm run check).
# Enabled by `npm install` (the prepare script); skip once with `git commit --no-verify`.
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0
echo "$files" | tr '\n' '\0' | xargs -0 npx --yes prettier@3 --check --ignore-unknown || {
  echo "Formatting check failed. Run 'npm run format', stage the changes, then commit again." >&2
  exit 1
}
