# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# browser test failure screenshots and traces
/test-results/

# Source art (Mixamo FBX downloads); only converted, compressed models are committed.
assets-src/
# Character models: downloaded from the private IoTProjectApp/iotquest-models by
# scripts/fetch-models.mjs (Mixamo files may not be published in this public repository).
public/models/

# World editor (editor/): its own Electron install.
editor/node_modules/
